rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(storeId) {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ).data.isActive == true;
    }

    function hasRole(storeId, roles) {
      return isMember(storeId) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)
        ).data.role in roles;
    }

    function canReadStore(storeId) {
      return isMember(storeId);
    }

    function canManageStore(storeId) {
      return hasRole(storeId, ['owner', 'admin']);
    }

    function canPostAccounting(storeId) {
      return hasRole(storeId, ['owner', 'admin', 'accountant']);
    }

    function canManageInventory(storeId) {
      return hasRole(storeId, ['owner', 'admin', 'warehouse']);
    }

    function canManageParties(storeId) {
      return hasRole(storeId, ['owner', 'admin', 'accountant', 'sales']);
    }

    function canManageCategories(storeId) {
      return hasRole(storeId, ['owner', 'admin', 'warehouse']);
    }

    function canManageOffers(storeId) {
      return hasRole(storeId, ['owner', 'admin', 'accountant', 'sales']);
    }


    function isChatParticipant(storeId, roomId) {
      return canReadStore(storeId) &&
        exists(
          /databases/$(database)/documents/stores/$(storeId)/chatRooms/$(roomId)
        ) &&
        get(
          /databases/$(database)/documents/stores/$(storeId)/chatRooms/$(roomId)
        ).data.storeId == storeId &&
        request.auth.uid in get(
          /databases/$(database)/documents/stores/$(storeId)/chatRooms/$(roomId)
        ).data.participantIds;
    }

    function canManageChatRoom(storeId, roomId) {
      return isChatParticipant(storeId, roomId) &&
        (
          get(
            /databases/$(database)/documents/stores/$(storeId)/chatRooms/$(roomId)
          ).data.createdBy == request.auth.uid ||
          canManageStore(storeId)
        );
    }

    function sameChatRoomStableFields() {
      return request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.isGroup == resource.data.isGroup &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.groupDescription ==
          resource.data.groupDescription &&
        request.resource.data.isArchived == resource.data.isArchived;
    }

    function canUpdateChatProjection(storeId, roomId) {
      return isChatParticipant(storeId, roomId) &&
        sameChatRoomStableFields() &&
        request.resource.data.lastMessageSenderId == request.auth.uid &&
        request.resource.data.lastMessageAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }

    function canMarkChatRead(storeId, roomId) {
      return isChatParticipant(storeId, roomId) &&
        sameChatRoomStableFields() &&
        request.resource.data.lastMessageAt == resource.data.lastMessageAt &&
        request.resource.data.lastMessageText == resource.data.lastMessageText &&
        request.resource.data.lastMessageSenderId ==
          resource.data.lastMessageSenderId &&
        request.resource.data.updatedAt is timestamp;
    }

    function canManageChatRoomUpdate(storeId, roomId) {
      return canManageChatRoom(storeId, roomId) &&
        request.resource.data.storeId == resource.data.storeId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.isGroup == resource.data.isGroup &&
        request.resource.data.participantIds is list &&
        request.resource.data.participants is list;
    }

    function canManageRepairs(storeId) {
      return hasRole(storeId, ['owner', 'admin', 'accountant', 'sales']);
    }

    // Only the authenticated user can read their selection.
    // All mutations are handled by callable Functions after membership checks.
    match /user_store_preferences/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /stores/{storeId} {
      allow read: if canReadStore(storeId);
      allow create: if false;
      allow update: if canManageStore(storeId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        (
          !('currency' in resource.data) ||
          request.resource.data.currency == resource.data.currency
        ) &&
        (
          !('initialChartVersion' in resource.data) ||
          request.resource.data.initialChartVersion ==
            resource.data.initialChartVersion
        ) &&
        (
          !('initialChartAccountCount' in resource.data) ||
          request.resource.data.initialChartAccountCount ==
            resource.data.initialChartAccountCount
        );
      allow delete: if false;

      match /members/{userId} {
        // A member must be able to read their own active membership to establish
        // the session. Owners and admins can read the complete member list.
        // Own membership GET must also work for missing/inactive docs so
        // onboarding can distinguish no membership from network/permission errors.
        allow get: if (
          signedIn() && userId == request.auth.uid
        ) || canManageStore(storeId);
        allow list: if canManageStore(storeId);
        allow create, update, delete: if canManageStore(storeId);
      }

      match /notificationTokens/{tokenId} {
        allow read: if false;
        allow create, update: if isMember(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.platform is string;
        allow delete: if isMember(storeId) &&
          resource.data.userId == request.auth.uid;
      }

      match /accounts/{accountId} {
        allow read: if canReadStore(storeId);
        // All chart writes now go through mutateChartAccount. This callable
        // changes the audit mutation revision in the same transaction.
        // Direct owner writes would otherwise bypass the revision guard.
        allow create, update, delete: if false;
      }

      match /products/{productId} {
        allow read: if canReadStore(storeId);
        allow create: if canManageInventory(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.quantityOnHandMilliUnits == 0 &&
          request.resource.data.inventoryValueMinorUnits == 0;
        allow update: if canManageInventory(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.quantityOnHandMilliUnits ==
            resource.data.quantityOnHandMilliUnits &&
          request.resource.data.inventoryValueMinorUnits ==
            resource.data.inventoryValueMinorUnits;
        allow delete: if false;
      }

      match /parties/{partyId} {
        allow read: if canReadStore(storeId);
        allow create: if canManageParties(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.partyType in ['customer', 'supplier'] &&
          request.resource.data.name is string;
        allow update: if canManageParties(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.partyType == resource.data.partyType &&
          request.resource.data.name is string;
        allow delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if canReadStore(storeId);
        allow create, update: if canManageCategories(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.name is string;
        allow delete: if false;
      }

      match /offers/{offerId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /offer_idempotency/{key} {
        allow read, write: if false;
      }

      match /offer_orders/{orderId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /offer_order_idempotency/{key} {
        allow read, write: if false;
      }

      match /offer_order_confirmation_idempotency/{key} {
        allow read, write: if false;
      }

      match /repairs/{repairId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /repair_payment_idempotency/{key} {
        allow read, write: if false;
      }

      match /sales/{saleId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;

        match /lines/{lineId} {
          allow read: if canReadStore(storeId);
          allow create, update, delete: if false;
        }
      }

      match /sale_idempotency/{key} {
        allow read, write: if false;
      }

      match /purchases/{purchaseId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;

        match /lines/{lineId} {
          allow read: if canReadStore(storeId);
          allow create, update, delete: if false;
        }
      }

      match /purchase_orders/{orderId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /purchase_order_receipt_idempotency/{key} {
        allow read, write: if false;
      }

      match /purchase_idempotency/{key} {
        allow read, write: if false;
      }

      match /command_outbox/{commandId} {
        allow read: if canReadStore(storeId) &&
          resource.data.createdBy == request.auth.uid;
        allow create: if canReadStore(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.operation in [
            'postSale',
            'postPurchase',
            'postPartyPayment',
            'settleCheque',
            'postExpense',
            'postAccountTransfer',
            'postJournalEntry',
            'postInventoryMovement',
            'createPurchaseOrder',
            'cancelPurchaseOrder',
            'receivePurchaseOrder',
            'createOffer',
            'updateOffer',
            'setOfferActive',
            'archiveOffer',
            'createOfferOrder',
            'cancelOfferOrder',
            'confirmOfferOrder',
            'createRepair',
            'updateRepair',
            'deliverRepair',
            'postRepairAdvance',
            'postRepairPayment'
          ] &&
          request.resource.data.idempotencyKey is string;
        allow update: if canReadStore(storeId) &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.storeId == storeId &&
          request.resource.data.createdBy == request.auth.uid;
        allow delete: if canReadStore(storeId) &&
          resource.data.createdBy == request.auth.uid;
      }

      match /account_transfers/{transferId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /account_transfer_idempotency/{key} {
        allow read, write: if false;
      }

      match /expenses/{expenseId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /expense_idempotency/{key} {
        allow read, write: if false;
      }

      match /party_payments/{paymentId} {
        // Individual receipts can be checked by active store members, but
        // enumerating the complete financial voucher register is accounting-only.
        allow get: if canReadStore(storeId);
        allow list: if canPostAccounting(storeId);
        allow create, update, delete: if false;
      }

      match /party_payment_idempotency/{key} {
        allow read, write: if false;
      }

      match /cheque_settlement_idempotency/{key} {
        allow read, write: if false;
      }

      match /party_ledger_entries/{entryId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /party_balances/{balanceId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /inventory_movements/{movementId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /inventory_idempotency/{key} {
        allow read, write: if false;
      }

      match /journal_entries/{entryId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;

        match /lines/{lineId} {
          allow read: if canReadStore(storeId);
          allow create, update, delete: if false;
        }
      }

      match /account_balances/{accountId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      // Checkpoint state is Cloud Functions-owned, not client-editable.
      // A forged cursor/phase could otherwise falsely claim complete history.
      match /accounting_audit_runs/{runId} {
        allow read, write: if false;
      }

      // Audit checkpoints/results cannot be forged by any client.
      match /accounting_ledger_runs/{runId} {
        allow read, write: if false;
        match /account_results/{accountId} {
          allow read, write: if false;
        }
      }

      // Journal header/line reconciliation evidence is server-owned only.
      match /accounting_journal_runs/{runId} {
        allow read, write: if false;
        match /entry_results/{entryId} {
          allow read, write: if false;
        }
      }

      // Path-based census state is trusted audit evidence, server-owned.
      match /accounting_orphan_path_runs/{runId} {
        allow read, write: if false;
      }

      // Reverse balance census checkpoints are exclusively server-owned.
      match /accounting_balance_path_runs/{runId} {
        allow read, write: if false;
      }

      // Sharded financial posting revision fence, only Cloud Functions may
      // change these counters as part of the posted journal transaction.
      match /accounting_posting_epochs/{shardId} {
        allow read, write: if false;
      }

      // Only server-side owner/admin callables can freeze/reopen accounting.
      // No client may forge the current financial close or its evidence.
      match /accounting_period_control/{controlId} {
        allow read, write: if false;
      }

      match /accounting_close_events/{eventId} {
        allow read, write: if false;
      }

      match /idempotency_keys/{key} {
        allow read, write: if false;
      }


      match /notes/{noteId} {
        allow read: if isMember(storeId) &&
          resource.data.storeId == storeId &&
          resource.data.userId == request.auth.uid;
        allow create: if isMember(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.content is string &&
          request.resource.data.type is string &&
          request.resource.data.priority is string;
        allow update: if isMember(storeId) &&
          resource.data.storeId == storeId &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.title is string &&
          request.resource.data.content is string &&
          request.resource.data.type is string &&
          request.resource.data.priority is string;
        allow delete: if false;
      }

      match /activity_logs/{activityId} {
        allow read: if canReadStore(storeId);
        allow create, update, delete: if false;
      }

      match /chatRooms/{roomId} {
        allow read: if isChatParticipant(storeId, roomId);
        allow create: if canReadStore(storeId) &&
          request.resource.data.storeId == storeId &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.participantIds is list &&
          request.auth.uid in request.resource.data.participantIds &&
          request.resource.data.participants is list &&
          request.resource.data.type in [
            'direct',
            'group',
            'support',
            'announcement'
          ];
        allow update: if canUpdateChatProjection(storeId, roomId) ||
          canMarkChatRead(storeId, roomId) ||
          canManageChatRoomUpdate(storeId, roomId);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isChatParticipant(storeId, roomId);
          allow create: if isChatParticipant(storeId, roomId) &&
            request.resource.data.storeId == storeId &&
            request.resource.data.roomId == roomId &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.senderName is string &&
            request.resource.data.content is string &&
            request.resource.data.type in [
              'text',
              'image',
              'file',
              'audio',
              'video',
              'location',
              'system'
            ] &&
            request.resource.data.attachmentUrls is list;
          allow update: if isChatParticipant(storeId, roomId) &&
            resource.data.senderId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.roomId == resource.data.roomId &&
            request.resource.data.storeId == resource.data.storeId &&
            request.resource.data.isDeleted == true;
          allow delete: if false;
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
